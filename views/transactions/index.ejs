<%- include('../partials/header') %>
<div class="page-toolbar"><div class="filter-links"><a class="<%= !status?'active':'' %>" href="/transactions">All</a><a class="<%= status==='Issued'?'active':'' %>" href="/transactions?status=Issued">Issued</a><a class="<%= status==='Overdue'?'active':'' %>" href="/transactions?status=Overdue">Overdue</a><a class="<%= status==='Returned'?'active':'' %>" href="/transactions?status=Returned">Returned</a></div><a class="btn primary" href="/transactions/new">＋ Issue Book</a></div>
<div class="panel"><div class="table-wrap"><table><thead><tr><th>Book</th><th>Member</th><th>Issue date</th><th>Due date</th><th>Return date</th><th>Status</th><th>Fine</th><th>Action</th></tr></thead><tbody>
<% transactions.forEach(t=>{ %><tr><td><b><%= t.book?.title || 'Deleted book' %></b><small><%= t.book?.isbn || '—' %></small></td><td><b><%= t.member?.name || 'Deleted member' %></b><small><%= t.member?.membershipId || '—' %></small></td><td><%= new Date(t.issueDate).toLocaleDateString('en-IN') %></td><td><%= new Date(t.dueDate).toLocaleDateString('en-IN') %></td><td><%= t.returnDate ? new Date(t.returnDate).toLocaleDateString('en-IN') : '—' %></td><td><span class="badge <%= t.status.toLowerCase() %>"><%= t.status %></span></td><td><%= t.fine ? '₹' + t.fine : '—' %></td><td><% if(t.status==='Issued'||t.status==='Overdue'){ %><form action="/transactions/<%= t._id %>/return?_method=PUT" method="post"><button class="btn small primary" onclick="return confirm('Mark this book as returned?')">Return</button></form><% } else { %><span class="muted">Completed</span><% } %></td></tr><% }) %>
<% if(!transactions.length){ %><tr><td colspan="8" class="empty"><div class="empty-icon">↔</div><b>No transactions found</b><small>Issue a book to create your first transaction.</small></td></tr><% } %>
</tbody></table></div></div>
<%- include('../partials/footer') %>
