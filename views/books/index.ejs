<%- include('../partials/header') %>
<div class="page-toolbar"><form class="search-box" action="/books" method="get"><span>⌕</span><input name="q" value="<%= q %>" placeholder="Search by title, author, ISBN or publisher..."><% if(category){ %><input type="hidden" name="category" value="<%= category %>"><% } %><button>Search</button></form><a class="btn primary" href="/books/new">＋ Add Book</a></div>
<div class="filter-row"><span class="muted"><%= books.length %> book record<%= books.length===1?'':'s' %></span><div class="filter-links"><a class="<%= !category?'active':'' %>" href="/books<%= q?'?q='+encodeURIComponent(q):'' %>">All</a><% categories.forEach(c=>{ %><a class="<%= category===c?'active':'' %>" href="/books?q=<%= encodeURIComponent(q) %>&category=<%= encodeURIComponent(c) %>"><%= c %></a><% }) %></div></div>
<div class="panel"><div class="table-wrap"><table><thead><tr><th>Book</th><th>ISBN</th><th>Category</th><th>Publisher</th><th>Availability</th><th>Actions</th></tr></thead><tbody>
<% books.forEach(book=>{ %><tr><td><div class="book-cell"><% if(book.coverUrl){ %><img class="mini-cover image-cover" src="<%= book.coverUrl %>" alt="<%= book.title %>"><% } else { %><div class="mini-cover">▤</div><% } %><div><b><%= book.title %></b><small>by <%= book.author %> · <%= book.publishedYear %></small></div></div></td><td><code><%= book.isbn %></code></td><td><span class="tag"><%= book.category %></span></td><td><%= book.publisher || '—' %></td><td><span class="availability <%= book.availableCopies===0?'none':'' %>"><%= book.availableCopies %> / <%= book.totalCopies %> available</span></td><td><div class="actions"><a href="/books/<%= book._id %>/edit">Edit</a><form action="/books/<%= book._id %>?_method=DELETE" method="post" onsubmit="return confirm('Delete this book?')"><button class="link danger-text">Delete</button></form></div></td></tr><% }) %>
<% if(!books.length){ %><tr><td colspan="6" class="empty"><div class="empty-icon">▤</div><b>No books found</b><small>Try a different search or add your first book.</small></td></tr><% } %>
</tbody></table></div></div>
<%- include('../partials/footer') %>
